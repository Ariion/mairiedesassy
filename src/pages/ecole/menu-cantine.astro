---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { dateLongue } from '../../data/url';

const menus = (await getCollection('menus')).sort((a, b) => +b.data.semaine - +a.data.semaine);
const [courant, ...anciens] = menus;
const fin = (d: Date) => new Date(+d + 4 * 864e5);
---
<Page section="École & cantine" title="Menu de la cantine" lead="Les repas de la semaine servis aux élèves du SIVOM, du lundi au vendredi (hors mercredi).">
  {courant ? (
    <section class="section">
      <div class="sec-head"><h2>Semaine du {dateLongue(courant.data.semaine, false)} au {dateLongue(fin(courant.data.semaine))}</h2></div>
      <div class="menu-week">
        {courant.data.jours.map((j) => (
          <div class="menu-day">
            <h3>{j.jour}</h3>
            <dl><dt>Entrée</dt><dd>{j.entree}</dd><dt>Plat</dt><dd>{j.plat}</dd><dt>Dessert</dt><dd>{j.dessert}</dd></dl>
          </div>
        ))}
      </div>
    </section>
  ) : <p class="empty">Le menu de la semaine sera publié prochainement.</p>}
  <p class="note">Menus susceptibles de modifications selon les approvisionnements. Pour toute allergie ou régime particulier, contactez le SIVOM.</p>
  {anciens.length > 0 && (
    <section class="section">
      <div class="list-card"><h2>Semaines précédentes</h2>
      <ul class="archive">
        {anciens.map((m) => <li><span class="notice-date">{m.data.semaine.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' })}</span><span>{m.data.jours.map((j) => j.plat).join(' · ')}</span><span></span></li>)}
      </ul></div>
    </section>
  )}
</Page>
