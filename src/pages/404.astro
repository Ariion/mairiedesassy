---
import Base from '../layouts/Base.astro';
import { url } from '../data/url';
---
<Base title="Page introuvable">
  <div class="page-hero">
    <div class="wrap">
      <header class="page-head" style="padding-block:96px">
        <span class="kicker">Erreur 404</span>
        <h1>Page introuvable.</h1>
        <p class="lead">La page demandée n’existe pas ou a été déplacée.</p>
        <div class="actions"><a class="btn btn-primary" href={url()}>Retour à l’accueil</a><a class="btn btn-secondary" href={url('contact/')}>Contacter la mairie</a></div>
      </header>
    </div>
  </div>
</Base>
