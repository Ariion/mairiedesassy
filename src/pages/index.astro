---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Blason from '../components/Blason.astro';
import NewsCard from '../components/NewsCard.astro';
import BriefRow from '../components/BriefRow.astro';
import { mairie } from '../data/site';
import { dateBloc, url } from '../data/url';
import { affichageRecent, evenementsTries, articlesRecents } from '../data/queries';
import photoMairie from '../assets/sassy-mairie.webp';
import photoEglise from '../assets/sassy-eglise.webp';

const aLaUne = (await articlesRecents()).slice(0, 2);
const brefs = (await affichageRecent()).slice(0, 4);
const { aVenir } = await evenementsTries();
const agenda = aVenir.slice(0, 3);

const demarches = [
  { icon: 'clipboard', titre: 'État civil', txt: 'Naissance, mariage, décès, PACS…', href: 'demarches/etat-civil/' },
  { icon: 'home', titre: 'Urbanisme', txt: 'Permis, déclaration préalable, certificat…', href: 'demarches/urbanisme/' },
  { icon: 'school', titre: 'École', txt: 'Inscriptions, cantine, périscolaire…', href: 'ecole/menu-cantine/' },
  { icon: 'cross', titre: 'Cimetière', txt: 'Concessions, inhumations, entretien…', href: 'demarches/cimetiere/' },
];
---
<Base>
  <section class="hero">
    <div class="hero-img">
      <Image src={photoEglise} alt="L’église Saint-Gervais-et-Saint-Protais de Sassy" widths={[800, 1200, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap hero-inner">
      <div class="hero-card">
        <h1>Bienvenue à Sassy</h1>
        <p>Retrouvez ici les actualités de la commune, les informations pratiques et vos démarches auprès de la mairie.</p>
        <div class="actions">
          <a class="btn btn-primary" href={url('vie-locale/blog/')}><Icon name="newspaper" size={18} />Actualités</a>
          <a class="btn btn-secondary" href={url('demarches/etat-civil/')}><Icon name="users" size={18} />Démarches</a>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap home-grid">
    <section class="une" aria-labelledby="une">
      <h2 class="h-rule" id="une">À la une</h2>
      <div class="news-grid">{aLaUne.map((a) => <NewsCard entry={a} />)}</div>
      <a class="more" href={url('vie-locale/blog/')}>Voir toutes les actualités <Icon name="arrow" size={16} /></a>
    </section>

    <aside class="moment" aria-labelledby="moment">
      <h2 class="h-ico" id="moment"><Icon name="megaphone" size={24} />En ce moment à Sassy</h2>
      <div class="briefs">{brefs.map((b) => <BriefRow entry={b} />)}</div>
      <a class="more" href={url('mairie/affichage/')}>Tout l’affichage mairie <Icon name="arrow" size={16} /></a>
    </aside>
  </div>

  <div class="wrap">
    <section class="demarches" aria-labelledby="demarches">
      <div class="demarches-main">
        <h2 class="h-ico" id="demarches"><Icon name="clipboard" size={26} />Vos démarches</h2>
        <div class="dem-grid">
          {demarches.map((d) => (
            <a class="dem" href={url(d.href)}>
              <Icon name={d.icon} size={30} />
              <b>{d.titre}</b>
              <span>{d.txt}</span>
              <Icon name="arrow" size={16} class="dem-go" />
            </a>
          ))}
        </div>
      </div>
      <div class="demarches-art" aria-hidden="true"><Blason size={150} /></div>
    </section>
  </div>

  <div class="wrap home-grid bottom">
    <section class="agenda" aria-labelledby="agenda">
      <h2 class="h-ico" id="agenda"><Icon name="calendar" size={26} />Agenda</h2>
      <div class="agenda-list">
        {agenda.length ? agenda.map((e) => {
          const { jour, mois } = dateBloc(e.data.date);
          return (
            <div class="ag">
              <span class="ag-date"><b>{jour}</b>{mois}</span>
              <span class="ag-body"><b>{e.data.titre}</b><span>{e.data.heure && `À ${e.data.heure} – `}{e.data.lieu}</span></span>
            </div>
          );
        }) : <p class="empty">Aucun événement annoncé pour le moment.</p>}
      </div>
      <a class="more" href={url('vie-locale/evenements/')}>Voir tout l’agenda <Icon name="arrow" size={16} /></a>
    </section>

    <section class="mairie-card" aria-labelledby="la-mairie">
      <div class="mairie-info">
        <h2 class="h-ico" id="la-mairie"><Icon name="pin" size={26} />La mairie</h2>
        <p class="mi"><Icon name="pin" size={18} /><span>{mairie.adresse[0]}<br />{mairie.adresse[1]}</span></p>
        <div class="mi"><Icon name="clock" size={18} /><span><b>Horaires d’ouverture</b>
          {mairie.horaires.map((h) => <span class="h">{h.jour} : {h.heures}{h.note && ` (${h.note})`}</span>)}
        </span></div>
        <p class="mi"><Icon name="phone" size={18} /><a href={mairie.telephoneHref}>{mairie.telephone}</a></p>
        <p class="mi"><Icon name="mail" size={18} /><a href={`mailto:${mairie.email}`}>{mairie.email}</a></p>
        <a class="btn btn-primary" href={url('contact/')}>Nous contacter</a>
      </div>
      <div class="mairie-photo">
        <Image src={photoMairie} alt="La mairie de Sassy et le monument aux morts" widths={[500, 800]} sizes="(max-width: 900px) 100vw, 320px" />
      </div>
    </section>
  </div>

  <section class="discover-band" aria-labelledby="decouvrir">
    <svg class="hills" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 120 C200 70 380 150 620 110 S1040 60 1440 110 V200 H0Z" fill="#cfe2d4" />
      <path d="M0 150 C240 110 460 170 760 140 S1180 110 1440 150 V200 H0Z" fill="#9fc6aa" />
      <path d="M0 175 C300 150 560 195 880 172 S1260 160 1440 180 V200 H0Z" fill="#6fa47e" />
    </svg>
    <div class="wrap discover-inner">
      <h2 class="h-ico" id="decouvrir"><Icon name="leaf" size={26} />Découvrir Sassy</h2>
      <p>Une commune, une histoire, un patrimoine : du « Châtelet » médiéval aux Vauquelin et à l’église du XIIᵉ siècle.</p>
      <div class="actions">
        <a class="btn btn-primary" href={url('decouvrir/histoire/')}>Découvrir le village <Icon name="arrow" size={16} /></a>
        <a class="btn btn-secondary" href={url('decouvrir/carte/')}>Carte</a>
      </div>
    </div>
  </section>
</Base>
