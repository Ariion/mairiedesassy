---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import { mairie } from '../data/site';
import { dateBloc, url } from '../data/url';
import { evenementsTries, articlesRecents } from '../data/queries';
import photoTour from '../assets/sassy-tour.webp';
import photoEglise from '../assets/sassy-eglise.webp';
import photoMairie from '../assets/sassy-mairie.webp';

const actus = (await articlesRecents()).slice(0, 3);
const { aVenir } = await evenementsTries();
const agenda = aVenir.slice(0, 3);

const tagAuteur: Record<string, string> = { Mairie: 'green', 'Association patrimoine': 'gold', SIVOM: 'blue', 'Comité des fêtes': 'red' };
const dateCourte = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
const partenaires = [
  { nom: 'Pays de Falaise', href: mairie.interco.url },
  { nom: 'Calvados', href: 'https://www.calvados.fr' },
  { nom: 'Région Normandie', href: 'https://www.normandie.fr' },
  { nom: 'Service-Public.fr', href: 'https://www.service-public.fr' },
];
---
<Base>
  <div class="wrap hero-wrap">
    <section class="hero" aria-labelledby="titre">
      <Image src={photoTour} alt="Tour de pierre dans la campagne de Sassy" widths={[800, 1280, 2000]} sizes="(max-width: 1440px) 100vw, 1280px" loading="eager" fetchpriority="high" />
      <div class="hero-content">
        <span class="chip chip-glass">Commune de Sassy · 14170</span>
        <h1 id="titre">Bienvenue à <em>Sassy</em>, village du Pays de Falaise.</h1>
        <p>Démarches, affichage municipal, agenda, école et patrimoine : toute la vie de la commune, au même endroit.</p>
        <div class="actions">
          <Btn href={url('demarches/etat-civil/')} variant="white">Faire une démarche</Btn>
          <Btn href={url('vie-locale/evenements/')} variant="outline">Agenda du village</Btn>
        </div>
      </div>
      <div class="hero-hours">
        <span class="open">MAIRIE OUVERTE</span>
        <strong>Lun. 11h–12h · Jeu. 14h–15h · Sam. 8h–12h (RDV)</strong>
        <span><a href={mairie.telephoneHref}>{mairie.telephone}</a> · <a href={`mailto:${mairie.email}`}>{mairie.email}</a></span>
      </div>
    </section>

    <div class="partners">
      <span>Avec</span>
      {partenaires.map((p) => <a href={p.href}>{p.nom}</a>)}
    </div>
  </div>

  <section class="wrap sec" aria-labelledby="univers">
    <div class="sec-title">
      <span class="chip">Pour vous</span>
      <h2 id="univers">Deux façons de vivre Sassy.</h2>
      <p>Vous habitez la commune ou vous venez la découvrir : choisissez votre porte d’entrée.</p>
    </div>
    <div class="duo">
      <article class="univers univers-green">
        <span class="ico"><Icon name="home" size={22} /></span>
        <h3>J’habite Sassy</h3>
        <p>Démarches, affichage, menus de la cantine, location de la salle communale : les services de la mairie au quotidien.</p>
        <div class="pills">
          <a href={url('demarches/etat-civil/')}>État civil</a><a href={url('demarches/urbanisme/')}>Urbanisme</a><a href={url('ecole/menu-cantine/')}>Cantine</a><a href={url('mairie/location-de-salle/')}>Location de salle</a>
        </div>
        <Btn href={url('mairie/')} variant="white">Services aux habitants</Btn>
      </article>
      <article class="univers univers-blue">
        <span class="ico"><Icon name="leaf" size={22} /></span>
        <h3>Je découvre Sassy</h3>
        <p>Une église du XIIᵉ siècle, le porche des Vauquelin, les chemins de la plaine : mille ans d’histoire à parcourir.</p>
        <div class="pills">
          <a href={url('decouvrir/histoire/')}>Histoire</a><a href={url('decouvrir/patrimoine/')}>Patrimoine</a><a href={url('decouvrir/photos/')}>Photos</a><a href={url('decouvrir/carte/')}>Carte</a>
        </div>
        <Btn href={url('decouvrir/histoire/')} variant="blue">Découvrir le village</Btn>
      </article>
    </div>
  </section>

  <section class="wrap sec" style="padding-top:0" aria-labelledby="moment">
    <div class="sec-row">
      <div class="sec-title">
        <span class="chip">Actualités</span>
        <h2 id="moment">En ce moment à Sassy</h2>
      </div>
      <Btn href={url('vie-locale/blog/')}>Toutes les actualités</Btn>
    </div>
    <div class="news">
      {actus.map((a) => (
        <article class="news-card">
          <Image src={a.data.image ?? photoMairie} alt="" widths={[400, 800]} sizes="(max-width: 760px) 100vw, 400px" />
          <div class="body">
            <div class="meta"><span class={`tag tag-${tagAuteur[a.data.auteur]}`}>{a.data.auteur}</span>{dateCourte(a.data.date)}</div>
            <h3><a href={url(`vie-locale/blog/${a.id}/`)}>{a.data.titre}</a></h3>
            <p>{a.data.extrait}</p>
            <span class="more">Lire la suite <Icon name="arrowUR" size={14} /></span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <div class="wrap" style="padding-bottom:clamp(56px,7vw,80px)">
    <section class="heritage" aria-labelledby="histoire">
      <div class="text">
        <span class="chip chip-gold">Patrimoine</span>
        <h2 id="histoire">Mille ans d’histoire, du Châtelet aux Vauquelin.</h2>
        <p>En 1498, la terre de Sassy passe à la famille de Vauquelin, dont le poète Jean Vauquelin de la Fresnaye. De leur manoir subsistent un porche monumental et un colombier.</p>
        <ul class="checks">
          <li><Icon name="check" size={14} />Église Saint-Gervais-et-Saint-Protais, XIIᵉ siècle</li>
          <li><Icon name="check" size={14} />Porche et colombier du Châtelet, classés en 1932</li>
          <li><Icon name="check" size={14} />Un seigneur de «&nbsp;Sacy&nbsp;» à Hastings en 1066</li>
        </ul>
        <Btn href={url('decouvrir/histoire/')} variant="white">L’histoire du village</Btn>
      </div>
      <figure class="collage">
        <span class="disc" aria-hidden="true"></span>
        <Image class="c1" src={photoEglise} alt="L’église Saint-Gervais-et-Saint-Protais" widths={[400, 675]} sizes="330px" />
        <Image class="c2" src={photoTour} alt="Tour de pierre dans la campagne" widths={[400, 800]} sizes="250px" />
        <Image class="c3" src={photoMairie} alt="La mairie et le monument aux morts" widths={[400, 675]} sizes="250px" />
      </figure>
    </section>
  </div>

  <section class="wrap sec" style="padding-top:0" aria-labelledby="chiffres">
    <div class="sec-title center">
      <span class="chip">Sassy en chiffres</span>
      <h2 id="chiffres">Un village à taille humaine.</h2>
      <p>Au cœur du Pays de Falaise, entre plaine de Caen et vallée de la Dives.</p>
    </div>
    <div class="figures">
      <div class="figure figure-white"><b>{mairie.population}</b><span>habitants ({mairie.populationAnnee})</span></div>
      <div class="figure figure-green"><b>{mairie.superficie}</b><span>de plaine et de vallée</span></div>
      <div class="figure figure-blue"><b>XIIᵉ</b><span>siècle : l’église du village</span></div>
      <div class="figure figure-red"><b>1066</b><span>un seigneur de «&nbsp;Sacy&nbsp;» à Hastings</span></div>
    </div>
  </section>

  <section class="wrap sec" style="padding-top:0">
    <div class="split">
      <div class="agenda">
        <div class="sec-row" style="margin-bottom:0">
          <div class="sec-title" style="margin:0">
            <span class="chip chip-red">Agenda</span>
            <h2>Prochains rendez-vous</h2>
          </div>
          <a class="link-more" href={url('vie-locale/evenements/')}>Tout l’agenda <Icon name="arrowUR" size={15} /></a>
        </div>
        {agenda.length ? agenda.map((e) => {
          const { jour, mois } = dateBloc(e.data.date);
          return (
            <article class="ev">
              <div class="ev-date"><b>{jour}</b><span>{mois.replace('.', '')}</span></div>
              <div><h3>{e.data.titre}</h3><p>{e.data.lieu}{e.data.heure && ` · ${e.data.heure}`}</p></div>
            </article>
          );
        }) : <p class="empty">Aucun événement annoncé pour le moment.</p>}
      </div>

      <section class="townhall" aria-labelledby="mairie">
        <Image src={photoMairie} alt="La mairie de Sassy, rue de la Forge" widths={[600, 675]} sizes="(max-width: 980px) 100vw, 560px" />
        <h2 id="mairie">La mairie vous répond</h2>
        <dl>
          <dt>Adresse</dt><dd>{mairie.adresse.join(' · ')}</dd>
          <dt>Horaires</dt><dd>Lun. 11h–12h · Jeu. 14h–15h · Sam. 8h–12h (RDV)</dd>
          <dt>Téléphone</dt><dd><a href={mairie.telephoneHref}>{mairie.telephone}</a></dd>
          <dt>E-mail</dt><dd><a href={`mailto:${mairie.email}`}>{mairie.email}</a></dd>
        </dl>
        <Btn href={url('contact/')}>Écrire à la mairie</Btn>
      </section>
    </div>
  </section>
</Base>
