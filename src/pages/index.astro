---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import NoticeRow from '../components/NoticeRow.astro';
import EventRow from '../components/EventRow.astro';
import PostCard from '../components/PostCard.astro';
import { mairie } from '../data/site';
import { url } from '../data/url';
import { affichageRecent, evenementsTries, articlesRecents } from '../data/queries';
import photoMairie from '../assets/sassy-mairie.webp';
import photoEglise from '../assets/sassy-eglise.webp';

/** Options de la maquette : photo du hero et affichage du blog. */
const photoAccueil: 'Mairie' | 'Église' = 'Mairie';
const afficherBlog = true;

const affichage = (await affichageRecent()).slice(0, 4);
const { aVenir } = await evenementsTries();
const events = aVenir.slice(0, 3);
const posts = (await articlesRecents()).slice(0, 3);

const services = [
  { n: '01', titre: 'Menu de la cantine', txt: 'Les repas de la semaine pour les élèves du SIVOM.', href: 'ecole/menu-cantine/' },
  { n: '02', titre: 'Location de salle', txt: 'Tarifs, capacité et contact pour réserver la salle communale.', href: 'mairie/location-de-salle/' },
  { n: '03', titre: 'Revues du village', txt: 'La revue mensuelle et la revue trimestrielle en PDF.', href: 'vie-locale/revue-mensuelle/' },
  { n: '04', titre: 'Annuaire des pros', txt: 'Artisans, agriculteurs, gîtes et commerces de Sassy.', href: 'vie-locale/annuaire/' },
];
---
<Base>
  <div class="wrap">
    <section class="hero">
      <div class="hero-text">
        <span class="kicker">Commune de Sassy · 14170 · Calvados</span>
        <h1>Bienvenue<br />à Sassy.</h1>
        <p class="lead">Un village du Pays de Falaise, entre plaine et vallée de la Dives. Retrouvez ici l’affichage municipal, l’agenda, la vie de l’école et l’histoire du village.</p>
        <div class="actions">
          <a class="btn btn-primary" href={url('mairie/affichage/')}>Voir l’affichage mairie →</a>
          <a class="btn btn-secondary" href={url('vie-locale/evenements/')}>Agenda du village</a>
        </div>
      </div>
      <figure>
        {photoAccueil === 'Mairie'
          ? <Image src={photoMairie} alt="La mairie de Sassy et le monument aux morts" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 560px" loading="eager" />
          : <Image src={photoEglise} alt="L’église de Sassy" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 560px" loading="eager" />}
      </figure>
    </section>

    <div class="stats">
      <div class="stat"><span class="stat-n">{mairie.population}</span><span class="stat-l">Habitants ({mairie.populationAnnee})</span></div>
      <div class="stat"><span class="stat-n">{mairie.superficie}</span><span class="stat-l">Superficie</span></div>
      <div class="stat"><span class="stat-n">XIIᵉ</span><span class="stat-l">Église St-Gervais-St-Protais</span></div>
      <div class="stat"><span class="stat-n">1066</span><span class="stat-l">Un seigneur de « Sacy » à Hastings</span></div>
    </div>

    <section class="cols-2">
      <div id="affichage" class="col">
        <div class="sec-head"><h2>Affichage mairie</h2><a class="btn btn-ghost" href={url('mairie/affichage/')}>Tout voir →</a></div>
        {affichage.map((e) => <NoticeRow entry={e} />)}
      </div>
      <div id="agenda" class="col">
        <div class="sec-head"><h2>Événements</h2><a class="btn btn-ghost" href={url('vie-locale/evenements/')}>Agenda complet →</a></div>
        {events.length ? events.map((e) => <EventRow entry={e} />) : <p class="empty">Aucun événement annoncé pour le moment.</p>}
      </div>
    </section>

    <section class="section">
      <div class="sec-head"><h2>Au quotidien</h2></div>
      <div class="tiles">
        {services.map((s) => (
          <a class="tile" href={url(s.href)}>
            <span class="tile-n">{s.n}</span>
            <span class="tile-t">{s.titre}</span>
            <span class="tile-x">{s.txt}</span>
          </a>
        ))}
      </div>
    </section>

    {afficherBlog && posts.length > 0 && (
      <section class="section">
        <div class="sec-head"><h2>Le blog du village</h2><a class="btn btn-ghost" href={url('vie-locale/blog/')}>Tous les articles →</a></div>
        <div class="posts">{posts.map((p) => <PostCard entry={p} />)}</div>
      </section>
    )}

    <section id="decouvrir" class="discover">
      <figure>
        <Image src={photoEglise} alt="Église Saint-Gervais-et-Saint-Protais de Sassy" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 560px" />
        <figcaption>Église Saint-Gervais-et-Saint-Protais, XIIᵉ siècle</figcaption>
      </figure>
      <div class="discover-text">
        <span class="kicker">Découvrir Sassy</span>
        <h2>Du Châtel aux Vauquelin, mille ans d’histoire</h2>
        <p>Un château fort, le « Châtelet », dominait l’entrée du village. En 1498, la terre passe à la famille de Vauquelin, dont le poète Jean Vauquelin de la Fresnaye (1535–1607). Son manoir a laissé un porche monumental, protégé au titre des monuments historiques.</p>
        <div class="actions">
          <a class="btn btn-secondary" href={url('decouvrir/histoire/')}>L’histoire du village →</a>
          <a class="btn btn-ghost" href={url('decouvrir/photos/')}>Photos</a>
          <a class="btn btn-ghost" href={url('decouvrir/carte/')}>Carte</a>
        </div>
      </div>
    </section>
  </div>

  <section id="contact" class="contact-band">
    <div class="wrap">
      <h2>Une question ?<br />La mairie vous répond.</h2>
      <div class="contact-cols">
        <div><span class="lbl">Adresse</span>{mairie.adresse[0]}<br />{mairie.adresse[1]}</div>
        <div><span class="lbl">Horaires</span>Lundi 11h–12h<br />Jeudi 14h–15h<br />Samedi 8h–12h (RDV)</div>
        <div><span class="lbl">Joindre</span><a href={mairie.telephoneHref}>{mairie.telephone}</a><a href={`mailto:${mairie.email}`}>mairiedesassy<br />@wanadoo.fr</a></div>
      </div>
    </div>
  </section>
</Base>
