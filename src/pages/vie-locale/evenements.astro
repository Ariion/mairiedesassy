---
import Page from '../../layouts/Page.astro';
import EventRow from '../../components/EventRow.astro';
import { evenementsTries } from '../../data/queries';
import { url } from '../../data/url';

const { aVenir, passes } = await evenementsTries();
---
<Page section="Vie locale" title="Agenda" lead="L’agenda du village : fêtes, cérémonies, balades et rendez-vous des associations.">
  <div class="cols-2">
    <section class="panel">
      <div class="sec-head"><h2>À venir</h2></div>
      <div class="rows">{aVenir.length ? aVenir.map((e) => <EventRow entry={e} details />) : <p class="empty">Aucun événement annoncé pour le moment.</p>}</div>
    </section>
    <aside class="col">
      <div class="box box-green">
        <h2>Annoncer un événement</h2>
        <p>Vous organisez une manifestation à Sassy (association, fête, vide-greniers…) ? Transmettez la date, l’heure, le lieu et l’organisateur à la mairie pour qu’elle figure dans l’agenda.</p>
        <a class="btn btn-primary" href={url('contact/')}>Écrire à la mairie</a>
      </div>
      {passes.length > 0 && (
        <div class="panel" style="margin-top:24px">
          <div class="sec-head"><h2>Passés</h2></div>
          <div class="rows">{passes.slice(0, 6).map((e) => <EventRow entry={e} />)}</div>
        </div>
      )}
    </aside>
  </div>
</Page>
