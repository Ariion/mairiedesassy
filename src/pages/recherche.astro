---
import Base from '../layouts/Base.astro';
import { url } from '../data/url';
---
<Base title="Rechercher">
  <link slot="head" href={url('pagefind/pagefind-ui.css')} rel="stylesheet" />
  <div class="page-hero">
    <div class="wrap">
      <header class="page-head">
        <h1>Rechercher sur le site</h1>
        <p class="lead">Une démarche, un compte rendu, un événement : tapez quelques mots.</p>
      </header>
    </div>
  </div>
  <div class="wrap page-body">
    <div id="recherche" class="search-box"></div>
    <noscript><p class="note">La recherche nécessite JavaScript. Consultez le <a href={url('plan-du-site/')}>plan du site</a>.</p></noscript>
  </div>
  <script is:inline define:vars={{ bundle: url('pagefind/') }}>
    const s = document.createElement('script');
    s.src = bundle + 'pagefind-ui.js';
    s.onload = () => {
      const ui = new PagefindUI({ element: '#recherche', bundlePath: bundle, showSubResults: true, showImages: false,
        translations: { placeholder: 'Rechercher…', zero_results: 'Aucun résultat pour [SEARCH_TERM]' } });
      const q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
    };
    document.head.append(s);
  </script>
</Base>
