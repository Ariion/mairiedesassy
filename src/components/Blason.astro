---
/**
 * Blason de Sassy, version stylisée d'après le blasonnement :
 * « Tiercé en pairle renversé : sinople au colombier d'or, gueules à deux
 * léopards d'or, argent à trois fasces ondées d'azur et trèfle de sinople ».
 * À remplacer par le fichier vectoriel officiel dès qu'il est disponible.
 */
interface Props { size?: number; class?: string }
const { size = 48, class: cls } = Astro.props;
const id = `b${Math.random().toString(36).slice(2, 8)}`;
const leopard = 'M0 5.5 C1.5 3.5 3 3.6 4.5 4 L11 4 C12 3.4 12.6 2 12.8 .6 L14.2 1.4 C14.4 2.6 14 3.8 13.2 4.6 L13.6 8.4 L12 8.4 L11.4 6 L5.6 6 L4.8 8.4 L3.2 8.4 L3.4 5.6 C2.2 6.4 1 6.4 0 5.5 Z M11.6 2.6 L12.2 1 L13.4 1.6 Z';
---
<svg class={cls} width={size} height={size * 1.2} viewBox="0 0 100 120" role="img" aria-label="Blason de Sassy">
  <defs>
    <clipPath id={id}><path d="M4 4H96V58C96 88 74 106 50 116C26 106 4 88 4 58Z" /></clipPath>
  </defs>
  <g clip-path={`url(#${id})`}>
    <path d="M0 0H50V64L0 104Z" fill="#1f6b3a" />
    <path d="M50 0H100V104L50 64Z" fill="#c8102e" />
    <path d="M0 104L50 64L100 104V120H0Z" fill="#fff" />
    <!-- colombier -->
    <g fill="#d9a61c">
      <path d="M17 26L27 16L37 26Z" />
      <rect x="19" y="26" width="16" height="20" />
      <rect x="25" y="36" width="4" height="10" fill="#1f6b3a" />
    </g>
    <!-- léopards -->
    <path d={leopard} fill="#d9a61c" transform="translate(64 16) scale(1.75)" />
    <path d={leopard} fill="#d9a61c" transform="translate(64 38) scale(1.75)" />
    <!-- trèfle -->
    <g fill="#1f6b3a">
      <circle cx="50" cy="78" r="3.4" /><circle cx="46" cy="83" r="3.4" /><circle cx="54" cy="83" r="3.4" />
      <path d="M49.3 84h1.4v6h-1.4z" />
    </g>
    <!-- fasces ondées -->
    <g fill="none" stroke="#1f4e9c" stroke-width="3">
      <path d="M20 96q5-4 10 0t10 0t10 0t10 0t10 0t10 0" />
      <path d="M26 103q5-4 10 0t10 0t10 0t10 0t10 0" />
      <path d="M32 110q5-4 10 0t10 0t10 0t10 0" />
    </g>
    <path d="M50 0V64M50 64L0 104M50 64L100 104" stroke="#0b2b18" stroke-width="1" fill="none" opacity=".35" />
  </g>
  <path d="M4 4H96V58C96 88 74 106 50 116C26 106 4 88 4 58Z" fill="none" stroke="#0b2b18" stroke-width="3" />
</svg>
