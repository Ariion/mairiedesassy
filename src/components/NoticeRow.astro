---
import type { CollectionEntry } from 'astro:content';
import { dateCourte, url } from '../data/url';
interface Props { entry: CollectionEntry<'affichage'> }
const { entry } = Astro.props;
const d = entry.data;
const slug = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/\s+/g, '-');
---
<a class="notice" href={url(`mairie/affichage/${entry.id}/`)}>
  <span class="notice-date"><time datetime={d.date.toISOString().slice(0, 10)}>{dateCourte(d.date)}</time></span>
  <span class="notice-body"><span class="notice-title">{d.titre}</span><span class="notice-info">{d.info}</span></span>
  <span class={`tag tag-${slug(d.type)}`}>{d.type}</span>
</a>
