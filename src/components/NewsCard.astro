---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { dateLongue, url } from '../data/url';

interface Props { entry: CollectionEntry<'articles'> }
const { entry } = Astro.props;
const d = entry.data;
const theme = { Mairie: 'green', 'Association patrimoine': 'gold', SIVOM: 'blue', 'Comité des fêtes': 'red' }[d.auteur];
const icon = { Mairie: 'landmark', 'Association patrimoine': 'leaf', SIVOM: 'school', 'Comité des fêtes': 'calendar' }[d.auteur];
---
<article class={`news news-${theme}`}>
  <div class="news-media">
    {d.image
      ? <Image src={d.image} alt="" widths={[400, 800]} sizes="(max-width: 700px) 100vw, 380px" />
      : <div class="news-placeholder" aria-hidden="true"><Icon name={icon} size={44} /></div>}
    <span class="news-tag">{d.auteur}</span>
  </div>
  <div class="news-body">
    <h3><a href={url(`vie-locale/blog/${entry.id}/`)}>{d.titre}</a></h3>
    <p>{d.extrait}</p>
    <span class="news-date"><Icon name="calendar" size={14} />{dateLongue(d.date)}</span>
    <span class="news-more">Lire la suite <Icon name="arrow" size={15} /></span>
  </div>
</article>
