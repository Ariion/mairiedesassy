---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter';
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import { mairie, nav } from '../data/site';
import { url } from '../data/url';

interface Props {
  title?: string;
  description?: string;
  /** Rubrique courante (label de nav) pour aria-current. */
  section?: string;
}
const { title, description = 'Site officiel de la commune de Sassy (14170, Calvados) : démarches, actualités, agenda, école et cantine, histoire et patrimoine du village.', section } = Astro.props;
const fullTitle = title ? `${title} · Commune de Sassy` : 'Commune de Sassy · 14170 · Calvados';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="fr_FR" />
  <meta name="theme-color" content="#f4efe6" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={url('sitemap-index.xml')} />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>

  <header class="header">
    <nav class="nav wrap" aria-label="Navigation principale">
      <a class="wordmark" href={url()} aria-label="Sassy, accueil"><b>Sassy</b><span>Commune du Calvados</span></a>

      <ul class="menu" role="list">
        {nav.map((s) => (
          <li>
            <a class="menu-link" href={url(s.href)} aria-current={section === s.label ? 'page' : undefined}>{s.label}</a>
            <div class="dd-panel">
              {s.items.map((i) => <a href={url(i.href)}>{i.label}</a>)}
            </div>
          </li>
        ))}
      </ul>

      <div class="nav-tools">
        <a class="tel" href={mairie.telephoneHref}>{mairie.telephone}</a>
        <a href={url('recherche/')} aria-label="Rechercher sur le site"><Icon name="search" size={19} /></a>
      </div>

      <details class="nav-menu">
        <summary class="nav-toggle">Menu</summary>
        <div class="nav-menu-panel">
          {nav.map((s) => (
            <div class="grp">
              <b class="label">{s.label}</b>
              {s.items.map((i) => <a href={url(i.href)}>{i.label}</a>)}
            </div>
          ))}
          <div class="grp">
            <b class="label">Mairie</b>
            <a href={mairie.telephoneHref}>{mairie.telephone}</a>
            <a href={url('recherche/')}>Rechercher</a>
          </div>
        </div>
      </details>
    </nav>
  </header>

  <main id="contenu" data-pagefind-body>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="blason-band" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="wrap footer-grid">
      <div>
        <div class="footer-mark">Sassy</div>
        <p>Mairie de Sassy<br />{mairie.adresse.join(', ')}<br /><a href={mairie.telephoneHref}>{mairie.telephone}</a> · <a href={`mailto:${mairie.email}`}>{mairie.email}</a></p>
      </div>
      {nav.map((s) => (
        <div>
          <b>{s.label}</b>
          <ul role="list">{s.items.map((i) => <li><a href={url(i.href)}>{i.label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="wrap footer-legal">
      <span>© Commune de Sassy · Maire : {mairie.maire}</span>
      <ul role="list">
        <li><a href={url('mentions-legales/')}>Mentions légales</a></li>
        <li><a href={url('accessibilite/')}>Accessibilité</a></li>
        <li><a href={url('plan-du-site/')}>Plan du site</a></li>
        <li><a href={mairie.interco.url}>Pays de Falaise</a></li>
      </ul>
    </div>
  </footer>
</body>
</html>
