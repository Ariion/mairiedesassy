---
import '@fontsource-variable/figtree';
import '../styles/site.css';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import blason from '../assets/blason-sassy.webp';
import { mairie, nav } from '../data/site';
import { url } from '../data/url';

interface Props {
  title?: string;
  description?: string;
  /** Rubrique courante (label de nav) pour aria-current. */
  section?: string;
}
const { title, description = 'Site officiel de la commune de Sassy (14170, Calvados) : démarches, actualités, agenda, école et cantine, histoire et patrimoine du village.', section } = Astro.props;
const fullTitle = title ? `${title} · Commune de Sassy` : 'Commune de Sassy · 14170 · Calvados';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="fr_FR" />
  <meta name="theme-color" content="#2a7a3b" />
  <link rel="icon" href={url('favicon.png')} type="image/png" />
  <link rel="sitemap" href={url('sitemap-index.xml')} />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>

  <header class="header">
    <nav class="nav wrap" aria-label="Navigation principale">
      <a class="brand" href={url()} aria-label="Sassy, accueil">
        <Image src={blason} alt="" width={92} height={101} loading="eager" />
        <span><b>Sassy</b><small>Commune · Calvados</small></span>
      </a>

      <ul class="menu" role="list">
        {nav.map((s) => (
          <li>
            <a class="menu-link" href={url(s.href)} aria-current={section === s.label ? 'page' : undefined}>{s.label}<Icon name="chevron" size={14} /></a>
            <div class="dd-panel">
              {s.items.map((i) => <a href={url(i.href)}>{i.label}</a>)}
            </div>
          </li>
        ))}
      </ul>

      <div class="nav-tools">
        <a class="icon-btn" href={url('recherche/')} aria-label="Rechercher sur le site"><Icon name="search" size={20} /></a>
        <Btn href={url('contact/')}>Contacter la mairie</Btn>
        <details class="nav-menu">
          <summary class="nav-toggle"><Icon name="menu" size={18} />Menu</summary>
          <div class="nav-menu-panel">
            {nav.map((s) => (
              <div class="grp">
                <b>{s.label}</b>
                {s.items.map((i) => <a href={url(i.href)}>{i.label}</a>)}
              </div>
            ))}
            <Btn href={url('contact/')}>Contacter la mairie</Btn>
          </div>
        </details>
      </div>
    </nav>
    <div class="blason-band" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  </header>

  <main id="contenu" data-pagefind-body>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="blason-band" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="wrap footer-grid">
      <div>
        <a class="brand" href={url()}>
          <Image src={blason} alt="" width={92} height={101} />
          <span><b>Sassy</b></span>
        </a>
        <p>Mairie de Sassy · {mairie.adresse.join(' · ')}<br /><a href={mairie.telephoneHref}>{mairie.telephone}</a> · <a href={`mailto:${mairie.email}`}>{mairie.email}</a></p>
      </div>
      {nav.map((s) => (
        <div>
          <h2>{s.label}</h2>
          <ul role="list">{s.items.map((i) => <li><a href={url(i.href)}>{i.label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="wrap footer-legal">
      <span>© Commune de Sassy · Maire : {mairie.maire}</span>
      <ul role="list">
        <li><a href={url('mentions-legales/')}>Mentions légales</a></li>
        <li><a href={url('accessibilite/')}>Accessibilité</a></li>
        <li><a href={url('plan-du-site/')}>Plan du site</a></li>
        <li><a href={mairie.interco.url}>Pays de Falaise</a></li>
      </ul>
    </div>
  </footer>

  <!-- Module Admin : édition du site avec ?admin (voir public/admin-config.js) -->
  <script is:inline src={url('admin-config.js')}></script>
  <script is:inline type="module" src={url('admin/runtime.js')}></script>
</body>
</html>
